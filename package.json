{
  "name": "checkpoint_twentyone",
  "version": "1.0.3",
  "private": false,
  "description": "A border control game in the browser. You are the officer at a Swedish checkpoint. Travellers come to your window one at a time, and you decide who gets in by checking their passport against the rules of the day.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:match": "vitest run -t",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --cache --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier ./src --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-mellin/checkpoint_twentyone.git"
  },
  "keywords": [],
  "author": "Mattias Mellin <mattias.mellin@gmail.com> <mm225vh@student.lnu.se>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/m-mellin/checkpoint_twentyone/issues"
  },
  "homepage": "https://github.com/m-mellin/checkpoint_twentyone#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^2.0.17",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "2d-sprite-renderer": "^1.1.1",
    "dice-rng-toolkit": "^0.1.0"
  }
}
